{
  "manifest_version": 3,
  "name": "Focus Blocker",
  "version": "1.1.0",
  "description": "Hard-blocks distracting sites during your work hours, with an optional lockdown mode.",
  "permissions": ["declarativeNetRequest", "storage", "alarms", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Blocker"
  },
  "options_page": "options.html"
}
